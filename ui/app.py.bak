# ==============================================================================
# TAB 1: LIVE CHART & OPTION SAFETY CHECK
# ==============================================================================
with tab1:
    # --- Chart Section ---
    st.markdown("<style>.stPills { display: flex; justify-content: center; margin-top: 10px; margin-bottom: 20px; }</style>", unsafe_allow_html=True)
    
    # Put pills outside the real-time fragment so it doesn't flicker and stays at the bottom
    # Actually, if we want it to look EXACTLY like the picture, it should be below the chart.
    
    @st.fragment(run_every="2s")
    def render_realtime_groww_chart():
        if 'tf_choice' not in st.session_state:
            st.session_state.tf_choice = "1D"
            
        tf_map = {
            "1D": ("5m", "1d"), 
            "1W": ("15m", "5d"), 
            "1M": ("1d", "1mo"), 
            "3M": ("1d", "3mo"), 
            "6M": ("1d", "6mo"),
            "1Y": ("1d", "1y"),
            "5Y": ("1wk", "5y"),
            "All": ("1mo", "max")
        }
        curr_int, curr_per = tf_map.get(st.session_state.tf_choice, ("5m", "1d"))

        live_spot, _, candles = LiveDataFeed.fetch_nifty_spot_and_candles(interval=curr_int, period=curr_per)
        
        # Calculate Baseline
        if not candles.empty:
            baseline = candles["Open"].iloc[0]
            current_close = candles["Close"].iloc[-1]
            diff = current_close - baseline
            diff_pct = (diff / baseline) * 100
        else:
            baseline = live_spot
            diff = 0
            diff_pct = 0
            
        is_bullish = diff >= 0
        line_color = "#00d09c" if is_bullish else "#eb5b3c"
        sign = "+" if is_bullish else ""
        
        # Top Header (Exact Groww Layout)
        st.markdown(f"""
        <div style="background: #161b22; padding: 24px 24px 0px 24px; border-radius: 12px 12px 0 0; border: 1px solid #30363d; border-bottom: none;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 1.4rem; font-weight: 600; color: #c9d1d9; letter-spacing: 0.5px;">NIFTY 50</div>
                    <div style="display: flex; align-items: baseline; gap: 12px; margin-top: 6px;">
                        <span style="font-size: 2.2rem; font-weight: 700; color: #f0f6fc;">{live_spot:,.2f}</span>
                        <span style="font-size: 1.1rem; font-weight: 600; color: {line_color};">{sign}{diff:,.2f} ({sign}{diff_pct:.2f}%) {st.session_state.tf_choice}</span>
                    </div>
                </div>
                <div>
                    <div style="color: #00d09c; font-weight: 600; font-size: 0.95rem; cursor: pointer;">🔗 Option Chain</div>
                </div>
            </div>
        </div>
        """, unsafe_allow_html=True)
        
        fig = go.Figure()
        
        # Main Line Chart
        fig.add_trace(go.Scatter(
            x=candles["time"],
            y=candles["Close"],
            mode="lines",
            name="Nifty",
            line=dict(color=line_color, width=2.5),
            hoverinfo="y"
        ))
        
        # Baseline Dotted Line
        if not candles.empty:
            fig.add_shape(
                type="line",
                x0=candles["time"].iloc[0],
                y0=baseline,
                x1=candles["time"].iloc[-1],
                y1=baseline,
                line=dict(color="#8b949e", width=1.5, dash="dash")
            )
        
        # Clean minimalist layout
        fig.update_layout(
            template="plotly_dark",
            paper_bgcolor="#161b22",
            plot_bgcolor="#161b22",
            height=300,
            margin=dict(l=0, r=0, t=10, b=0),
            xaxis_rangeslider_visible=False,
            hovermode="x unified",
            xaxis=dict(showgrid=False, zeroline=False, showticklabels=False, visible=False),
            yaxis=dict(showgrid=False, zeroline=False, showticklabels=False, visible=False),
            showlegend=False
        )
        
        # Render Chart with Border
        st.markdown("<div style='border: 1px solid #30363d; border-top: none; border-bottom: none; background: #161b22;'>", unsafe_allow_html=True)
        st.plotly_chart(fig, use_container_width=True)
        st.markdown("</div>", unsafe_allow_html=True)
        
        st.markdown("<div style='border: 1px solid #30363d; border-top: none; background: #161b22; padding: 10px 0px 20px 0px; border-radius: 0 0 12px 12px;'>", unsafe_allow_html=True)
        tf_opts = ["1D", "1W", "1M", "3M", "6M", "1Y", "5Y", "All"]
        selected_tf = st.pills("Timeframe", tf_opts, default=st.session_state.tf_choice, label_visibility="collapsed")
        if selected_tf and selected_tf != st.session_state.tf_choice:
            st.session_state.tf_choice = selected_tf
            st.rerun()
        st.markdown("</div>", unsafe_allow_html=True)

    # Render fragment
    render_realtime_groww_chart()
    
    st.markdown("<br>", unsafe_allow_html=True)

    # --- Scanner Section ---
    st.markdown("#### 🛡️ Option Safety & Health Scanner (Option Chain)")
    st.write("Evaluate live health across the option chain and instantly add trades to your portfolio.")

    atm_base = round(live_spot / 50.0) * 50.0
    strike_list = [int(atm_base + i * 50) for i in range(-5, 6)]

    st.markdown("<br>", unsafe_allow_html=True)
    
    # Header Row
    h1, h2, h3, h4, h5, h6 = st.columns([1.5, 2.5, 1.5, 2.5, 1.5, 2])
    h1.markdown("<div style='text-align: right; color: #8b949e; font-size: 0.9rem;'>**CALL LTP**</div>", unsafe_allow_html=True)
    h2.markdown("<div style='text-align: right; color: #8b949e; font-size: 0.9rem;'>**CALL VERDICT**</div>", unsafe_allow_html=True)
    h3.markdown("<div style='text-align: center; color: #8b949e; font-size: 0.9rem;'>**STRIKE**</div>", unsafe_allow_html=True)
    h4.markdown("<div style='text-align: left; color: #8b949e; font-size: 0.9rem;'>**PUT VERDICT**</div>", unsafe_allow_html=True)
    h5.markdown("<div style='text-align: left; color: #8b949e; font-size: 0.9rem;'>**PUT LTP**</div>", unsafe_allow_html=True)
    h6.markdown("<div style='text-align: center; color: #8b949e; font-size: 0.9rem;'>**ACTION**</div>", unsafe_allow_html=True)
    
    st.markdown("<hr style='margin: 5px 0px 10px 0px; border-top: 1px solid #30363d;'>", unsafe_allow_html=True)

    for strike in strike_list:
        c_eval = OptionEvaluator.evaluate_option_health(live_spot, strike, OptionType.CALL, TradeAction.BUY, 5, live_vix)
        p_eval = OptionEvaluator.evaluate_option_health(live_spot, strike, OptionType.PUT, TradeAction.BUY, 5, live_vix)
        
        c_rating = c_eval["health_rating"]
        p_rating = p_eval["health_rating"]
        
        c_pill = "pill-optimal" if c_rating == "OPTIMAL" else ("pill-speculative" if c_rating == "SPECULATIVE" else "pill-hazardous")
        p_pill = "pill-optimal" if p_rating == "OPTIMAL" else ("pill-speculative" if p_rating == "SPECULATIVE" else "pill-hazardous")
        
        col1, col2, col3, col4, col5, col6 = st.columns([1.5, 2.5, 1.5, 2.5, 1.5, 2])
        
        # Call Premium
        col1.markdown(f"<div style='text-align: right; font-weight: 600; font-family: monospace; font-size: 1.1rem; color: #f0f6fc; padding-top: 5px;'>₹{c_eval['premium']:.1f}</div>", unsafe_allow_html=True)
        
        # Call Verdict
        col2.markdown(f"<div style='text-align: right; padding-top: 5px;'><span class='pill-badge {c_pill}' style='font-size:0.75rem; padding: 4px 8px;'>{c_eval['health_badge']}</span></div>", unsafe_allow_html=True)
        
        # Strike (Center)
        if strike == atm_base:
            col3.markdown(f"<div style='text-align: center; font-weight: 800; font-size: 1.2rem; color: #58a6ff; background: #1f2937; border-radius: 4px; padding: 2px 0px;'>{strike}</div>", unsafe_allow_html=True)
        else:
            col3.markdown(f"<div style='text-align: center; font-weight: 700; font-size: 1.1rem; color: #c9d1d9; padding-top: 5px;'>{strike}</div>", unsafe_allow_html=True)
            
        # Put Verdict
        col4.markdown(f"<div style='text-align: left; padding-top: 5px;'><span class='pill-badge {p_pill}' style='font-size:0.75rem; padding: 4px 8px;'>{p_eval['health_badge']}</span></div>", unsafe_allow_html=True)
        
        # Put Premium
        col5.markdown(f"<div style='text-align: left; font-weight: 600; font-family: monospace; font-size: 1.1rem; color: #f0f6fc; padding-top: 5px;'>₹{p_eval['premium']:.1f}</div>", unsafe_allow_html=True)
        
        # Action Buttons
        with col6:
            b1, b2 = st.columns(2)
            if b1.button("➕ CE", key=f"add_ce_{strike}"):
                st.session_state.portfolio_manager.add_position(float(strike), OptionType.CALL, TradeAction.BUY, 50, c_eval['premium'], f"NIFTY {strike} CE")
                st.toast(f"✅ Added NIFTY {strike} CE to Portfolio!")
            if b2.button("➕ PE", key=f"add_pe_{strike}"):
                st.session_state.portfolio_manager.add_position(float(strike), OptionType.PUT, TradeAction.BUY, 50, p_eval['premium'], f"NIFTY {strike} PE")
                st.toast(f"✅ Added NIFTY {strike} PE to Portfolio!")
                
        st.markdown("<hr style='margin: 2px 0px; padding: 0px; border-top: 1px solid #21262d;'>", unsafe_allow_html=True)


# ==============================================================================
# TAB 2: TRADE TESTER (SHOULD I TAKE OR DROP?)
# ==============================================================================
with tab2:
    st.subheader("🧪 Trade Tester: Will this trade give Profit or Loss?")
    st.write("Test your trade before putting in real money. See what happens if Nifty moves up, down, or stays flat over 1–2 days.")

    t_col1, t_col2, t_col3, t_col4 = st.columns(4)
    with t_col1:
        t_strike = st.selectbox("Strike Price", strike_list, index=8, key="test_stk_sel")
    with t_col2:
        t_type_str = st.selectbox("Option Type", ["CALL (CE)", "PUT (PE)"], key="test_typ_sel")
        t_type = OptionType.CALL if "CALL" in t_type_str else OptionType.PUT
    with t_col3:
        t_act_str = st.selectbox("Action", ["BUY (Long)", "SELL (Short)"], key="test_act_sel")
        t_act = TradeAction.BUY if "BUY" in t_act_str else TradeAction.SELL
    with t_col4:
        t_lots = st.number_input("Number of Lots (50 Qty/Lot)", min_value=1, max_value=20, value=1)

    # Run Test Simulation
    sim_res = OptionEvaluator.test_trade_scenarios(
        spot_price=live_spot,
        strike_price=float(t_strike),
        option_type=t_type,
        action=t_act,
        days_to_expiry=5,
        india_vix=live_vix,
        num_lots=int(t_lots),
    )

    dec_color = sim_res["decision_color"]

    # Big Clear Recommendation Banner
    st.markdown(f"""
    <div style="background: {dec_color}18; border: 2px solid {dec_color}; border-radius: 12px; padding: 20px 24px; margin: 15px 0;">
        <div style="font-size: 1.4rem; font-weight: 800; color: {dec_color}; margin-bottom: 6px;">
            {sim_res['decision_badge']}
        </div>
        <div style="font-size: 1rem; color: #f0f6fc; margin-bottom: 6px;">
            <strong>Why:</strong> {sim_res['decision_reason']}
        </div>
        <div style="font-size: 0.9rem; color: #8b949e;">
            💡 <strong>Expert Tip:</strong> {sim_res['suggested_alternative']}
        </div>
    </div>
    """, unsafe_allow_html=True)

    # Quick Summary Cards
    h_data = sim_res["health"]
    k1, k2, k3 = st.columns(3)
    with k1:
        st.markdown(f"""
        <div class="clean-card">
            <div class="clean-metric-title">Total Trade Cost</div>
            <div class="clean-metric-val">₹{sim_res['total_investment_inr']:,.2f}</div>
            <div style="font-size: 0.8rem; color: #8b949e;">{t_lots} Lot ({t_lots*50} Qty) @ ₹{h_data['premium']:.2f}</div>
        </div>
        """, unsafe_allow_html=True)

    with k2:
        st.markdown(f"""
        <div class="clean-card">
            <div class="clean-metric-title">Estimated Profit Probability</div>
            <div class="clean-metric-val {'val-green' if h_data['prob_of_profit_pct'] >= 50 else 'val-red'}">{h_data['prob_of_profit_pct']:.0f}%</div>
            <div style="font-size: 0.8rem; color: #8b949e;">Delta: {h_data['delta']:.2f}</div>
        </div>
        """, unsafe_allow_html=True)

    with k3:
        st.markdown(f"""
        <div class="clean-card">
            <div class="clean-metric-title">Time Decay Loss if Nifty Stays Flat</div>
            <div class="clean-metric-val val-red">-₹{abs(h_data['theta_daily_inr']) * sim_res['total_quantity']:,.0f}/day</div>
            <div style="font-size: 0.8rem; color: #8b949e;">{h_data['daily_theta_burn_pct']:.1f}% of capital per day</div>
        </div>
        """, unsafe_allow_html=True)

    # Simple Scenario Outcome Table
    st.markdown("#### 🎯 Expected Profit & Loss Across Market Scenarios")
    
    # Format simplified scenario dataframe
    raw_sc = sim_res["scenario_table"]
    simple_sc = pd.DataFrame({
        "Nifty Move": raw_sc["nifty_move_pct"],
        "Target Nifty Level": raw_sc["target_nifty_spot"],
        "PnL Today (₹)": raw_sc["Today (T+0) PnL (₹)"],
        "PnL Tomorrow (₹)": raw_sc["Tomorrow (T+1) PnL (₹)"],
        "PnL at Expiry (₹)": raw_sc["Expiry (T=0) PnL (₹)"],
    })
    st.dataframe(simple_sc, use_container_width=True, hide_index=True)

    if st.button("➕ Add This Tested Trade to Portfolio", use_container_width=True):
        st.session_state.portfolio_manager.add_position(
            strike=float(t_strike),
            option_type=t_type,
            action=t_act,
            quantity=sim_res["total_quantity"],
            entry_price=h_data["premium"],
            symbol=f"NIFTY {t_strike} {t_type.value}",
        )
        st.success(f"Added NIFTY {t_strike} {t_type.value} to your Portfolio!")


# ==============================================================================
# TAB 3: MY PORTFOLIO & PAST TRADEBOOK
# ==============================================================================
with tab3:
    sub_col1, sub_col2 = st.columns([1, 1])

    pm = st.session_state.portfolio_manager
    port_mtm = pm.update_portfolio_mtm(current_spot=live_spot, india_vix=live_vix, days_to_expiry=5)

    # Left: Active Positions Book
    with sub_col1:
        st.markdown("### 💼 My Active Positions")
        
        # Top MTM Cards
        p_c1, p_c2 = st.columns(2)
        with p_c1:
            tot_pnl = port_mtm["total_mtm_pnl"]
            pnl_cls = "val-green" if tot_pnl >= 0 else "val-red"
            st.markdown(f"""
            <div class="clean-card">
                <div class="clean-metric-title">Total Live Profit / Loss</div>
                <div class="clean-metric-val {pnl_cls}">₹{tot_pnl:,.2f}</div>
                <div style="font-size: 0.8rem; color: #8b949e;">{port_mtm['total_mtm_pct']:+.1f}% on Invested Capital</div>
            </div>
            """, unsafe_allow_html=True)

        with p_c2:
            th_val = port_mtm["net_theta_per_day_inr"]
            th_cls = "val-green" if th_val >= 0 else "val-red"
            st.markdown(f"""
            <div class="clean-card">
                <div class="clean-metric-title">Portfolio Daily Decay</div>
                <div class="clean-metric-val {th_cls}">₹{th_val:,.1f}/day</div>
                <div style="font-size: 0.8rem; color: #8b949e;">{port_mtm['theta_status']}</div>
            </div>
            """, unsafe_allow_html=True)

        if port_mtm["total_positions"] > 0:
            st.markdown("<hr style='margin: 10px 0px; border-top: 1px solid #30363d;'>", unsafe_allow_html=True)
            
            # Column Headers
            h_c1, h_c2, h_c3, h_c4, h_c5, h_c6 = st.columns([2, 1, 1.5, 1.5, 1.5, 1])
            h_c1.markdown("**Contract**")
            h_c2.markdown("**Qty**")
            h_c3.markdown("**Entry ₹**")
            h_c4.markdown("**LTP ₹**")
            h_c5.markdown("**Live PnL**")
            h_c6.markdown("**Remove**")
            st.markdown("<hr style='margin: 5px 0px 10px 0px; border-top: 1px solid #30363d;'>", unsafe_allow_html=True)

            pos_df = port_mtm["positions_dataframe"]
            for idx, row in pos_df.iterrows():
                r_c1, r_c2, r_c3, r_c4, r_c5, r_c6 = st.columns([2, 1, 1.5, 1.5, 1.5, 1])
                r_c1.markdown(f"<span style='font-size:0.9rem;'>{row['symbol']}</span>", unsafe_allow_html=True)
                r_c2.markdown(f"<span style='font-size:0.9rem;'>{row['qty']}</span>", unsafe_allow_html=True)
                r_c3.markdown(f"<span style='font-size:0.9rem;'>₹{row['entry_px']:.1f}</span>", unsafe_allow_html=True)
                r_c4.markdown(f"<span style='font-size:0.9rem;'>₹{row['ltp']:.1f}</span>", unsafe_allow_html=True)
                
                pnl = row['mtm_pnl']
                pnl_color = "#3fb950" if pnl >= 0 else "#f85149"
                r_c5.markdown(f"<span style='font-size:0.9rem; font-weight:600; color:{pnl_color};'>₹{pnl:.1f}</span>", unsafe_allow_html=True)
                
                with r_c6:
                    if st.button("❌", key=f"del_{row['position_id']}", help="Remove Position"):
                        pm.remove_position(row['position_id'])
                        st.rerun()

            st.markdown("<hr style='margin: 10px 0px; border-top: 1px solid #30363d;'>", unsafe_allow_html=True)
            if st.button("🧹 Clear All Positions", type="secondary"):
                pm.clear_portfolio()
                st.rerun()
        else:
            st.info("No active positions yet. Add trades using Tab 1 or Tab 2.")

    # Right: Payoff Chart
    with sub_col2:
        st.markdown("### 📈 Portfolio Payoff Chart")
        
        if port_mtm["total_positions"] > 0:
            legs = []
            for p in pm.positions:
                legs.append(StrategyLeg(
                    action=p.action,
                    option_type=p.option_type,
                    strike=p.strike,
                    expiry_date=None,
                    quantity=p.quantity,
                    premium=p.entry_price
                ))

            if legs:
                profile = PayoffCalculator.calculate_strategy_profile(legs, live_spot, 5, 0.07, live_vix)
                
                fig = go.Figure()
                fig.add_hline(y=0, line_color="#8b949e", line_dash="dash", line_width=1)
                
                fig.add_trace(go.Scatter(
                    x=profile["price_range"], 
                    y=profile["expiry_payoff_curve"], 
                    mode="lines", 
                    name="Expiry Payoff", 
                    line=dict(color="#3fb950", width=2),
                    fill='tozeroy',
                    fillcolor='rgba(63, 185, 80, 0.1)'
                ))
                
                fig.add_trace(go.Scatter(
                    x=profile["price_range"], 
                    y=profile["t0_payoff_curve"], 
                    mode="lines", 
                    name="T+0 Payoff (Live)", 
                    line=dict(color="#58a6ff", width=2, dash="dot")
                ))
                
                fig.add_vline(x=live_spot, line_color="#f0f6fc", line_width=1.5, annotation_text="Live Spot")
                
                fig.update_layout(
                    template="plotly_dark", 
                    paper_bgcolor="#0d1117", 
                    plot_bgcolor="#161b22", 
                    height=350, 
                    margin=dict(l=10, r=10, t=20, b=10),
                    legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
                )
                st.plotly_chart(fig, use_container_width=True)
                
                sc_c1, sc_c2 = st.columns(2)
                sc_c1.metric("Max Profit", f"₹{profile['max_profit_inr']:,.0f}")
                sc_c2.metric("Max Loss", f"₹{profile['max_loss_inr']:,.0f}")
        else:
            st.info("Add options to see the combined payoff graph.")

    st.markdown("<br><br>", unsafe_allow_html=True)
    st.divider()
    
    # Bottom: Past Tradebook Auditor & Mistakes
    st.markdown("### 🚨 Mistakes Detected in Past Trades")
    st.write("Analysis of your historical tradebook to identify capital leakage.")
    
    sample_path = PROJECT_ROOT / "data" / "sample_zerodha_trades.csv"
    if sample_path.exists():
        _, _, tb_df = TradebookParser.parse_csv(str(sample_path))
        audit_res = LeakageDetector.audit_tradebook(tb_df, initial_capital=200000.0)
        sim_res_tb = CounterfactualSimulator.simulate_containment(tb_df, initial_capital=200000.0, max_daily_loss_inr=4000.0)

        # Health Score & Money Saved
        sc_c1, sc_c2 = st.columns(2)
        with sc_c1:
            b_score = audit_res["behavioral_health_score"]
            sc_cls = "val-green" if b_score >= 75 else ("val-amber" if b_score >= 50 else "val-red")
            st.markdown(f"""
            <div class="clean-card">
                <div class="clean-metric-title">Discipline Score</div>
                <div class="clean-metric-val {sc_cls}">{b_score}/100</div>
                <div style="font-size: 0.8rem; color: #8b949e;">Emotional Control Rating</div>
            </div>
            """, unsafe_allow_html=True)

        with sc_c2:
            saved_cap = sim_res_tb["net_capital_saved"]
            st.markdown(f"""
            <div class="clean-card">
                <div class="clean-metric-title">Money Saved with Stop-Loss</div>
                <div class="clean-metric-val val-green">+₹{saved_cap:,.2f}</div>
                <div style="font-size: 0.8rem; color: #8b949e;">Drawdown reduced by {sim_res_tb['drawdown_reduction_pct']:.0f}%</div>
            </div>
            """, unsafe_allow_html=True)

        # Mistakes List
        for leak in audit_res["leakage_breakdown"]:
            if leak["financial_damage"] > 0:
                st.markdown(f"- 🔴 **{leak['leak_type']}**: Lost **₹{leak['financial_damage']:,.0f}** ({leak['description']})")

        # Expandable Advanced Monte Carlo & Curve
        with st.expander("🔮 View Future Monte Carlo Simulation & Equity Curve"):
            tl = sim_res_tb["comparison_curve"]
            fig_comp = go.Figure()
            fig_comp.add_trace(go.Scatter(x=tl["date"], y=tl["actual_equity"], mode="lines", name="Actual PnL", line=dict(color="#f85149", width=2, dash="dot")))
            fig_comp.add_trace(go.Scatter(x=tl["date"], y=tl["sim_equity"], mode="lines", name="With Stop Loss Containment", line=dict(color="#3fb950", width=3)))
            fig_comp.update_layout(template="plotly_dark", paper_bgcolor="#0d1117", plot_bgcolor="#161b22", height=280, margin=dict(l=10, r=10, t=10, b=10))
            st.plotly_chart(fig_comp, use_container_width=True)
    else:
        st.info("No sample_zerodha_trades.csv found in data directory.")


# Simple Footer
st.markdown("---")
st.caption("🛡️ Predictive Drawdown Containment System • B.Tech Minor Project.")

# ==============================================================================
# TAB 4: ML & BACKTEST ANALYSIS
# ==============================================================================
with tab4:
    st.header("🤖 Machine Learning & Backtest Engine")
    st.markdown("Run a Monte Carlo style historical simulation using the Random Forest classifier to prove the mathematical edge of the strategy.")
    
    st.divider()
    
    # --- Input Options ---
    st.subheader("⚙️ Simulation Parameters")
    col1, col2 = st.columns(2)
    with col1:
        sim_trades = st.slider("Number of Historical Trades to Simulate", min_value=100, max_value=5000, value=1000, step=100)
    with col2:
        sim_capital = st.number_input("Initial Capital (₹)", min_value=10000.0, max_value=10000000.0, value=100000.0, step=10000.0)
    
    st.markdown("<br>", unsafe_allow_html=True)
    
    if st.button("🚀 Run Backtest Simulation", use_container_width=True):
        with st.spinner(f"Training Random Forest Classifier and running backtest over {sim_trades} trades..."):
            from backtesting.engine import BacktestEngine
            import pandas as pd
            import matplotlib.pyplot as plt
            import numpy as np
            
            engine = BacktestEngine(n_trades=sim_trades, initial_capital=sim_capital)
            results = engine.run_backtest()
            
            st.success("Simulation Complete! Model Accuracy metrics calculated.")
            st.divider()
            
            # --- 1. Top Level Metrics ---
            st.subheader("📊 Performance Metrics")
            
            # Drawdowns
            st.markdown("**Maximum Drawdown (Lower is better)**")
            c1, c2, c3 = st.columns(3)
            c1.metric("Baseline Strategy", f"{results['baseline']['max_drawdown']:.1f}%")
            
            rule_imp = results['baseline']['max_drawdown'] - results['rule_based']['max_drawdown']
            c2.metric("Rule-Based Strategy", f"{results['rule_based']['max_drawdown']:.1f}%", f"{rule_imp:.1f}% improvement")
            
            ml_imp = results['baseline']['max_drawdown'] - results['ml_based']['max_drawdown']
            c3.metric("ML-Based Strategy", f"{results['ml_based']['max_drawdown']:.1f}%", f"{ml_imp:.1f}% improvement")
            
            # Success Rates
            st.markdown("<br>**Success Rate (Higher is better)**", unsafe_allow_html=True)
            c4, c5, c6 = st.columns(3)
            c4.metric("Baseline Success Rate", f"{results['baseline']['success_rate']:.1f}%")
            
            rule_win_imp = results['rule_based']['success_rate'] - results['baseline']['success_rate']
            c5.metric("Rule-Based Success Rate", f"{results['rule_based']['success_rate']:.1f}%", f"{rule_win_imp:+.1f}%")
            
            ml_win_imp = results['ml_based']['success_rate'] - results['baseline']['success_rate']
            c6.metric("ML-Based Success Rate", f"{results['ml_based']['success_rate']:.1f}%", f"{ml_win_imp:+.1f}%")
            
            st.divider()
            
            # --- 2. Visuals ---
            chart_col1, chart_col2 = st.columns([3, 2])
            
            with chart_col1:
                st.subheader("📈 Equity Curve Comparison")
                # Prepare data for line chart
                df_chart = pd.DataFrame({
                    "Baseline": results['baseline']['equity_curve'],
                    "Rule-Based": results['rule_based']['equity_curve'],
                    "ML-Based": results['ml_based']['equity_curve']
                })
                # Streamlit line chart is interactive and clean
                st.line_chart(df_chart, color=["#ef4444", "#f59e0b", "#10b981"])
                
            with chart_col2:
                st.subheader("🧠 ML Feature Importance")
                st.markdown("Variables the AI found most predictive:")
                
                fi = results['feature_importances']
                df_fi = pd.DataFrame({"Feature": list(fi.keys()), "Importance": list(fi.values())})
                df_fi = df_fi.sort_values(by="Importance", ascending=True)
                
                fig, ax = plt.subplots(figsize=(5, 5))
                # Soft modern colors
                ax.barh(df_fi["Feature"], df_fi["Importance"], color="#3b82f6", alpha=0.8)
                ax.set_xlabel("Weight")
                ax.spines['top'].set_visible(False)
                ax.spines['right'].set_visible(False)
                st.pyplot(fig)
                
            st.divider()
            
            # --- 3. Final Capital Bar Chart ---
            st.subheader("💰 Final Capital Output")
            final_caps = pd.DataFrame({
                "Strategy": ["Baseline", "Rule-Based", "ML-Based"],
                "Final Capital (₹)": [
                    results['baseline']['final_capital'], 
                    results['rule_based']['final_capital'], 
                    results['ml_based']['final_capital']
                ]
            }).set_index("Strategy")
            
            st.bar_chart(final_caps, color="#10b981")
